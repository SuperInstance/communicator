{
  "date": "2026-10-20",
  "question": "Three committed audit runs were recorded as 'unparseable'. Did the model fail to answer, or was the answer cut off by the output budget -- and is the material budget implicated?",
  "pre_registered_rules": {
    "a_truncation_is": "finish_reason == 'length' on the API response",
    "a_recovery_is": "the SAME prompt, same model, same mode, with 4x the output token budget, returns a parseable JSON object",
    "the_material_hypothesis_is_refuted_if": "in blind mode the input-token count is IDENTICAL at every material budget, because the material is not in the blind prompt at all",
    "verdict": "the unparseable runs are an OUTPUT-budget failure if the truncation rate is non-zero and the 4x retry recovers them"
  },
  "the_defect": {
    "what": "debrief._http_json rebuilt every response as {'text': text} and discarded finish_reason and usage, so a response cut off at the output cap was indistinguishable from a finished one. cloud_llm's retry only fired on EMPTY content, which a truncated answer never has.",
    "fix": "finish_reason and usage are kept and surfaced as truncated/usage; cloud_llm retries a truncated answer with 4x the output budget; run_audit records the transport facts on every run and distinguishes 'response_was_truncated' from 'no_json_verdicts_object'."
  },
